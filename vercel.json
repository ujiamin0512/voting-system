{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/admin.html"
    },
    {
      "source": "/vote",
      "destination": "/vote.html"
    },
    {
      "source": "/projector",
      "destination": "/projector.html"
    },
    {
      "source": "/results",
      "destination": "/projector.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
